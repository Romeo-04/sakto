<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. allowBackup="false" stops cloud backup but not a
     device-to-device transfer. The database key lives in the Android
     Keystore, which is never copied, so a transferred database could not be
     opened. Exclude everything from both. A user moves to a new phone with
     CSV export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
